# Base de données
DATABASE_URL=postgresql://user:password@host:port/notiftam

# Sécurité des crons (Bearer envoyé par les cron jobs)
CRON_SECRET=change-me

# --- Publication X (API officielle, OAuth 1.0a) ---
# Créés sur https://developer.x.com (App en "Read and write").
# Tant que ces 4 variables ne sont pas définies, la publication est INACTIVE
# (postToTwitter ne fait rien) — la migration peut être déployée à blanc.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Source des alertes TaM (optionnel — défaut = Urbain + Suburbain).
# Liste séparée par des virgules pour surcharger.
# ALERT_URL=https://data.montpellier3m.fr/GTFS/Urbain/Alert.pb,https://data.montpellier3m.fr/GTFS/Suburbain/Alert.pb
