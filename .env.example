# Base de données
DATABASE_URL=postgresql://user:password@host:port/notiftam

# Sécurité des crons (Bearer envoyé par les cron jobs)
CRON_SECRET=change-me

# Publication : disabled (défaut), browser ou api. Aucun basculement automatique.
X_POSTING_MODE=disabled

# Mode navigateur : session créée localement avec npm run x:login.
# X_ACCOUNT_HANDLE vérifie le compte attendu ; USER_HANDLE reste accepté à défaut.
X_ACCOUNT_HANDLE=
X_BROWSER_SESSION_PATH=.x-browser/session.json
# Facultatif : Chrome local ou Chromium installé sur le serveur.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# L'ancien PUPPETEER_EXECUTABLE_PATH reste accepté si le fichier existe.

# --- Mode API facultatif (OAuth 1.0a) ---
# Créés sur https://developer.x.com (App en "Read and write").
# Ces variables ne sont utilisées que si X_POSTING_MODE=api.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Source des alertes TaM (optionnel — défaut = flux commun Urbain + Suburbain).
# Liste séparée par des virgules pour surcharger.
# Les anciennes URL data.montpellier3m.fr/GTFS/... ne sont plus disponibles.
# ALERT_URL=https://gtfsproxy.e-tam.fr/COMMON/Alert.pb
